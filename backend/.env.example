# コピーして .env を作成（.env は Git に登録しない）
# ローカル Docker の MySQL
DATABASE_URL=mysql+pymysql://pos:CHANGE_ME@127.0.0.1:3306/pos_app?charset=utf8mb4
# Azure Database for MySQL の場合（TLS 必須）
# DATABASE_URL=mysql+pymysql://<user>:<password>@<server>.mysql.database.azure.com:3306/pos_app?charset=utf8mb4
# DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# ローカル開発（http://localhost）では Secure Cookie が送れないため false にする。本番は必ず true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_TTL_MINUTES=480
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
# 別オリジン構成のときだけ本番フロントの URL を JSON 配列で（* は不可）
# CORS_ALLOW_ORIGINS=["https://<your-swa>.azurestaticapps.net"]
FORCE_HTTPS=false
LOG_LEVEL=INFO
